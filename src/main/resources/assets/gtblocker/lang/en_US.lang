# Commands
gtblocker.usage=/gtblocker [gui|list|history|lock <items>|unlock <items>|party ...|admin ...|voice join|leave]  (items: hand, hand*, modid:name[:meta|*])
gtblocker.usage.party=/gtblocker party [list|now <items>|at <time> <items>|start <id>|cancel <id>|spot <id> [clear]]
gtblocker.usage.admin=/gtblocker admin [list|add <player>|remove <player>]
gtblocker.usage.voice=/gtblocker voice join|leave
gtblocker.cmd.locks=Locked items (%s):
gtblocker.cmd.parties=Scheduled unlock parties (%s):
gtblocker.cmd.history=Unlock history (%s entries, latest 10):
gtblocker.cmd.admins=GTBlocker admins (%s): %s


# Comandi
gtblocker.usage=/gtblocker [gui|list|history|lock <oggetti>|unlock <oggetti>|party ...|admin ...|voice join|leave]  (oggetti: hand, hand*, modid:nome[:meta|*])
gtblocker.usage.party=/gtblocker party [list|now <oggetti>|at <ora> <oggetti>|start <id>|cancel <id>|spot <id> [clear]]
gtblocker.usage.admin=/gtblocker admin [list|add <giocatore>|remove <giocatore>]
gtblocker.usage.voice=/gtblocker voice join|leave
